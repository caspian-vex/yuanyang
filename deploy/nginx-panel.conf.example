# Install manually after setting YOUR_PANEL_DOMAIN and supplying a valid TLS cert.
# Do not publish the initial setup endpoint over cleartext HTTP.
server {
    listen 443 ssl;
    server_name YOUR_PANEL_DOMAIN;
    ssl_certificate /etc/yuanyang/panel.crt;
    ssl_certificate_key /etc/yuanyang/panel.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;
    location / {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 31m;
        proxy_send_timeout 31m;
    }
}
